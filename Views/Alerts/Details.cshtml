@model ObstructionAlert
@{
    ViewData["Title"] = "Alert Details";
    ViewData["PageTitle"] = "Alert Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0">
            <i class="bi bi-exclamation-triangle-fill me-2 text-@(Model.Severity == "Critical" ? "danger" : Model.Severity == "High" ? "warning" : "info")"></i>
            Alert #@Model.ObstructionAlertId - @Model.Title
        </h1>
    </div>
    <span class="badge bg-@(Model.Severity == "Critical" ? "danger" : Model.Severity == "High" ? "warning" : Model.Severity == "Medium" ? "info" : "secondary") fs-6">@Model.Severity</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Alert Details</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless table-sm">
                    <tbody>
                        <tr>
                            <th class="text-muted small">Canal</th>
                            <td>@Model.Canal?.CanalName — @Model.Canal?.Barangay, @Model.Canal?.City</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Alert Type</th>
                            <td>@Model.AlertType</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Obstruction Type</th>
                            <td>@Model.ObstructionType</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Severity</th>
                            <td>
                                <span class="badge bg-@(Model.Severity == "Critical" ? "danger" : Model.Severity == "High" ? "warning" : "info")">@Model.Severity</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Description</th>
                            <td>@Model.Description</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Water Level</th>
                            <td>
                                @Model.WaterLevel m
                                @if (Model.Canal != null)
                                {
                                    <span class="text-muted small">
                                        (Warning: @Model.Canal.WarningWaterLevel m, Critical: @Model.Canal.CriticalWaterLevel m)
                                    </span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Detected At</th>
                            <td>@Model.DetectedAt.ToString("g")</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Status</th>
                            <td>
                                <span class="badge bg-@(Model.Status == "Resolved" ? "success" : Model.Status == "In Progress" ? "warning" : Model.Status == "Acknowledged" ? "info" : Model.Status == "Dismissed" ? "secondary" : "danger")">@Model.Status</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Assigned To</th>
                            <td>@(Model.AssignedToUser?.FullName ?? "Unassigned")</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
                        {
                            <tr>
                                <th class="text-muted small">Resolution Notes</th>
                                <td>@Model.ResolutionNotes</td>
                            </tr>
                        }
                        @if (Model.ResolvedAt.HasValue)
                        {
                            <tr>
                                <th class="text-muted small">Resolved At</th>
                                <td>@Model.ResolvedAt.Value.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.SensorReading != null)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="bi bi-eyedropper me-2"></i>Related Sensor Reading</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm table-striped mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted small">Water Level</th>
                                <td>@Model.SensorReading.WaterLevel m</td>
                                <th class="text-muted small">Flow Rate</th>
                                <td>@Model.SensorReading.FlowRate m³/s</td>
                            </tr>
                            <tr>
                                <th class="text-muted small">Debris Level</th>
                                <td>@Model.SensorReading.DebrisLevel%</td>
                                <th class="text-muted small">Turbidity</th>
                                <td>@Model.SensorReading.Turbidity NTU</td>
                            </tr>
                            <tr>
                                <th class="text-muted small">Temperature</th>
                                <td>@Model.SensorReading.Temperature°C</td>
                                <th class="text-muted small">Recorded At</th>
                                <td>@Model.SensorReading.RecordedAt.ToString("g")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        @if ((User.IsInRole("Admin") || User.IsInRole("LGU") || User.IsInRole("Barangay") || User.IsInRole("Maintenance")))
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Update Status</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ObstructionAlertId" />
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Acknowledged">Acknowledged</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Dismissed">Dismissed</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Resolution Notes</label>
                            <textarea name="notes" class="form-control" rows="3" placeholder="Enter notes about the resolution..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check-lg me-1"></i>Update
                        </button>
                    </form>

                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Acknowledge" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ObstructionAlertId" />
                            <button type="submit" class="btn btn-outline-info w-100"
                                    @(Model.Status != "Active" && Model.Status != "Acknowledged" ? "disabled" : "")>
                                <i class="bi bi-hand-thumbs-up me-1"></i>Acknowledge
                            </button>
                        </form>
                    }
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0"><i class="bi bi-person-gear me-2"></i>Assign To</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Assign" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ObstructionAlertId" />
                            <div class="mb-3">
                                <select name="assigneeId" class="form-select">
                                    @if (ViewBag.Assignees != null)
                                    {
                                        foreach (var item in (SelectList)ViewBag.Assignees)
                                        {
                                            <option value="@item.Value" selected="@(item.Value.ToString() == (Model.AssignedToUserId?.ToString() ?? ""))">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-outline-warning w-100">
                                <i class="bi bi-person-check me-1"></i>Assign
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>
