@model IEnumerable<ObstructionAlert>
@{
    ViewData["Title"] = "Obstruction Alerts";
    ViewData["PageTitle"] = "Alerts Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Obstruction Alerts
    </h1>
    <a asp-controller="Alerts" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
    </a>
</div>

<form asp-action="Index" method="get" class="card border-0 shadow-sm p-3 mb-4">
    <input type="hidden" name="page" value="1" />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label small">Status</label>
            <select name="status" class="form-select form-select-sm" asp-items="@(ViewBag.AlertStatuses as SelectList)">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Severity</label>
            <select name="severity" class="form-select form-select-sm" asp-items="@(ViewBag.AlertSeverities as SelectList)">
                <option value="">All Severities</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel me-1"></i>Filter
            </button>
        </div>
    </div>
</form>

@{
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var retentionHours = (double)(ViewBag.RetentionHours ?? 5);
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentSeverity = ViewBag.CurrentSeverity as string;
    var fromRow = totalCount == 0 ? 0 : (currentPage - 1) * 20 + 1;
    var toRow = Math.Min(currentPage * 20, totalCount);
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <small class="text-muted">
        Showing <strong>@fromRow–@toRow</strong> of <strong>@totalCount</strong> alert(s)
        &middot; alerts older than @retentionHours.ToString("0.#") hours are automatically removed
    </small>
</div>

<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Canal</th>
                <th>Alert</th>
                <th>Severity</th>
                <th>Water Level</th>
                <th>Status</th>
                <th>Detected</th>
                <th>Assigned To</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var alert in Model)
                {
                    <tr>
                        <td class="small">@alert.ObstructionAlertId</td>
                        <td class="fw-medium">@alert.Canal?.CanalName</td>
                        <td>
                            <div class="fw-medium">@alert.Title</div>
                            <small class="text-muted text-truncate d-block" style="max-width: 200px;">@alert.Description</small>
                        </td>
                        <td>
                            <span class="badge bg-@SeverityStyles.BadgeClass(alert.Severity)">@alert.Severity</span>
                        </td>
                        <td class="small">@alert.WaterLevel m</td>
                        <td>
                            @{
                                var statusClass = alert.Status switch
                                {
                                    "Active" => "danger",
                                    "Acknowledged" => "info",
                                    "In Progress" => "warning",
                                    "Resolved" => "success",
                                    "Dismissed" => "secondary",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@statusClass">@alert.Status</span>
                        </td>
                        <td class="small text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(alert.DetectedAt).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(alert.DetectedAt) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(alert.DetectedAt)</time></td>
                        <td class="small">@(alert.AssignedToUser?.UserName ?? "Unassigned")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@alert.ObstructionAlertId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        <i class="bi bi-check-circle-fill me-2"></i>No alerts match the current filters.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    var prevDisabled = currentPage <= 1 ? "disabled" : null;
    var nextDisabled = currentPage >= totalPages ? "disabled" : null;
    <nav class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2" aria-label="Alerts pagination">
        <a class="btn btn-sm btn-outline-secondary @prevDisabled"
           asp-action="Index" asp-route-status="@currentStatus" asp-route-severity="@currentSeverity"
           asp-route-page="@(currentPage - 1)" aria-disabled="@(prevDisabled != null)">
            <i class="bi bi-chevron-left me-1"></i>Previous
        </a>
        <small class="text-muted">Page @currentPage of @totalPages</small>
        <a class="btn btn-sm btn-outline-secondary @nextDisabled"
           asp-action="Index" asp-route-status="@currentStatus" asp-route-severity="@currentSeverity"
           asp-route-page="@(currentPage + 1)" aria-disabled="@(nextDisabled != null)">
            Next<i class="bi bi-chevron-right ms-1"></i>
        </a>
    </nav>
}
