@model IEnumerable<UserRoleViewModel>
@{
    ViewData["Title"] = "Users";
    ViewData["PageTitle"] = "User Management";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var currentRole = (string?)ViewBag.CurrentRole;
    var query = (string?)ViewBag.Query;
}

<div class="page-head">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-people me-2 page-icon"></i>User Management</h1>
        <p class="page-sub">@totalCount account(s) · manage roles, credentials, and access.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Create User
    </a>
</div>

<div class="card table-card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label" for="userSearch">Search</label>
                <input id="userSearch" name="q" value="@query" class="form-control form-control-sm" placeholder="Username, full name, or email" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="roleFilter">Role</label>
                <select id="roleFilter" name="role" class="form-select form-select-sm">
                    <option value="">All roles</option>
                    @foreach (var r in roles)
                    {
                        if (string.Equals(r, currentRole, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>User Name</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-medium">@user.UserName</td>
                            <td>@user.FullName</td>
                            <td class="small">@user.Email</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="status-badge @StatusBadgeExtensions.StatusClass(role == "Admin" ? "Critical" : role == "LGU" ? "Verified" : role == "Barangay" ? "Resolved" : role == "Maintenance" ? "In Progress" : "Under Review")">@role</span>
                                }
                            </td>
                            <td class="small text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(user.CreatedAt).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(user.CreatedAt) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(user.CreatedAt)</time></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    <a asp-controller="Notifications" asp-action="Send" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Send Notification" aria-label="Send notification to @user.UserName">
                                        <i class="bi bi-bell"></i>
                                    </a>
                                    @if (user.UserName != User?.Identity?.Name)
                                    {
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <partial name="_EmptyState" model="@(new EmptyStateViewModel {
                                Icon = "bi-people",
                                Title = "No users match these filters",
                                Message = "Adjust the search or role filter, or create a new account."
                            })" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="@(new PaginationViewModel {
        Page = page, TotalPages = totalPages, TotalCount = totalCount,
        Action = "Index", Controller = "Users", Label = "users",
        RouteValues = new Dictionary<string, string> {
            { "q", query ?? string.Empty }, { "role", currentRole ?? string.Empty }
        }
    })" />
</div>


