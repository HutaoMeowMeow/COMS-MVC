@model RegisterViewModel
@{
    ViewData["Title"] = "Create User";
    ViewData["PageTitle"] = "Create User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-person-plus me-2"></i>Create User
    </h1>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>
</div>

<div class="alert alert-info">
    <i class="bi bi-envelope-check me-2"></i>
    The new account is <strong>not</strong> activated directly. A verification code is emailed to the address above
    and the account is created only after it is entered (same OTP workflow as self-registration).
    The Admin role cannot be granted here.
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small mb-3 py-2" })
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>User Information</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" maxlength="100" minlength="2" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" maxlength="30" minlength="3" required />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" maxlength="256" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" inputmode="tel" maxlength="20" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Barangay" class="form-label"></label>
                    <input asp-for="Barangay" class="form-control" maxlength="100" />
                    <span asp-validation-for="Barangay" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" maxlength="100" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" maxlength="250" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Role Assignment</h5>
        </div>
        <div class="card-body">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" class="form-select" asp-items="@(ViewBag.CreateRoles as SelectList)"></select>
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0"><i class="bi bi-key me-2"></i>Initial Password</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" minlength="6" maxlength="100" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" minlength="6" maxlength="100" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-text small text-muted mt-2">At least 6 characters, with 1 uppercase, 1 number, and 1 special character. Share it with the new user through a safe channel.</div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-envelope-plus me-1"></i>Create &amp; send verification code
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
