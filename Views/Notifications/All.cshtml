@model IEnumerable<Notification>
@{
    ViewData["Title"] = "All Notifications";
    ViewData["PageTitle"] = "All Notifications (Admin)";
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
}

<div class="page-head">
    <div>
        <h1 class="h3"><i class="bi bi-bell me-2 page-icon"></i>All Notifications</h1>
        <p class="page-sub">System-wide notification log · @totalCount record(s), newest first.</p>
    </div>
    <a asp-controller="Notifications" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>My Notifications
    </a>
</div>

<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Title</th>
                    <th>Message</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var notification in Model)
                    {
                        var typeClass = notification.Type switch
                        {
                            "Alert" => "danger",
                            "Report" or "Report Update" => "warning",
                            "Announcement" => "info",
                            "Maintenance" or "System" => "secondary",
                            "Important" => "danger",
                            _ => "primary"
                        };
                        <tr>
                            <td class="small">@notification.User?.UserName</td>
                            <td class="fw-medium">@notification.Title</td>
                            <td class="small text-muted">@notification.Message</td>
                            <td><span class="badge bg-@typeClass">@notification.Type</span></td>
                            <td class="small text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(notification.CreatedAt).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(notification.CreatedAt) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(notification.CreatedAt)</time></td>
                            <td>
                                <span class="status-badge @(notification.IsRead ? "st-resolved" : "st-pending")">@(notification.IsRead ? "Read" : "Unread")</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state py-4">
                                <div class="empty-icon"><i class="bi bi-bell-slash"></i></div>
                                <h6>No notifications found</h6>
                                <p class="mb-0">Notifications appear here as reports, alerts, and announcements are processed.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">Page @(page) of @totalPages</small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="All" asp-route-page="@(page - 1)">Previous</a>
                </li>
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="All" asp-route-page="@(page + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
