@model SendNotificationViewModel
@{
    ViewData["Title"] = "Send Notification";
    ViewData["PageTitle"] = "Send Notification";
}

<div class="page-head">
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary" aria-label="Back to users">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 mb-0">Send Notification</h1>
            <p class="page-sub">Private notification — visible only to the selected recipient.</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width: 48px; height: 48px;" aria-hidden="true">
                    <i class="bi bi-person-fill text-white fs-5"></i>
                </div>
                <div class="min-w-0">
                    <div class="text-muted small">Recipient</div>
                    <h5 class="mb-0 text-truncate">@Model.RecipientFullName (@Model.RecipientUserName)</h5>
                    <small class="text-muted">@Model.RecipientEmail · @string.Join(", ", Model.RecipientRoles)</small>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Send" asp-route-id="@Model.RecipientId" method="post">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small mb-3 py-2" })
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Important Notice" maxlength="150" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Message" class="form-label"></label>
                        <textarea asp-for="Message" class="form-control" rows="4" maxlength="2000"
                                  placeholder="Write the private message for this user..."></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="NotificationType" class="form-label">Type</label>
                        <select asp-for="NotificationType" class="form-select" asp-items="@(ViewBag.SendTypes as SelectList)"></select>
                        <span asp-validation-for="NotificationType" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-send me-1"></i>Send Notification
                        </button>
                        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
