@model CreateTicketViewModel
@{
    ViewData["Title"] = "Report a Problem";
    ViewData["PageTitle"] = "Report a Problem";
}

<div class="page-head">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary" aria-label="Back to customer service">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 mb-0">Report a Problem</h1>
            <p class="page-sub">Account, report, technical, or general inquiries — not canal problems.</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="ticketCreateForm">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small mb-3 py-2" })
                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label"></label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. I cannot log into my account" maxlength="150" data-char-counter="150" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                        <div class="form-text"><span data-char-count-for="Subject">0</span>/150 characters</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select" asp-items="@(ViewBag.Categories as SelectList)" id="categorySelect">
                                <option value="">Select a category…</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" class="form-select" asp-items="@(ViewBag.Priorities as SelectList)"></select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4" id="otherConcernGroup" style="display:none;">
                        <label asp-for="OtherConcern" class="form-label"></label>
                        <textarea asp-for="OtherConcern" class="form-control" rows="5" maxlength="500"
                                  placeholder="Describe your concern so we can route it to the right team."></textarea>
                        <span asp-validation-for="OtherConcern" class="text-danger small"></span>
                        <div class="form-text"><span data-char-count-for="OtherConcern">0</span>/500 characters</div>
                    </div>

                    <div class="mb-4" id="descriptionGroup">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000"
                                  placeholder="Describe the problem in detail so our team can help you faster."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                        <div class="form-text"><span data-char-count-for="Description">0</span>/2000 characters</div>
                    </div>

                    <div class="alert alert-info small mb-3" role="alert">
                        <i class="bi bi-info-circle me-1"></i>
                        Examples: "My account says unverified after confirming my email",
                        "I see duplicate charges on my bill", "The map won't load on my browser",
                        "I need to update my barangay address".
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill" data-loading>
                            <i class="bi bi-send me-1"></i>Submit Request
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';
            var category = document.getElementById('categorySelect');
            var otherGroup = document.getElementById('otherConcernGroup');
            var descGroup = document.getElementById('descriptionGroup');
            var otherTextarea = otherGroup ? otherGroup.querySelector('textarea') : null;
            var descTextarea = descGroup ? descGroup.querySelector('textarea') : null;

            if (category && otherGroup && descGroup) {
                function toggle() {
                    var isOther = category.value === 'Other';
                    // Toggle visibility
                    otherGroup.style.display = isOther ? 'block' : 'none';
                    descGroup.style.display = isOther ? 'none' : 'block';
                    // Toggle required attributes
                    if (otherTextarea) {
                        if (isOther) {
                            otherTextarea.setAttribute('required', 'required');
                            otherTextarea.setAttribute('aria-required', 'true');
                        } else {
                            otherTextarea.removeAttribute('required');
                            otherTextarea.setAttribute('aria-required', 'false');
                        }
                    }
                    if (descTextarea) {
                        if (isOther) {
                            descTextarea.removeAttribute('required');
                            descTextarea.setAttribute('aria-required', 'false');
                        } else {
                            descTextarea.setAttribute('required', 'required');
                            descTextarea.setAttribute('aria-required', 'true');
                        }
                    }
                    // Clear validation messages on the hidden field
                    if (isOther && descTextarea) {
                        var descMsg = descTextarea.closest('.mb-4').querySelector('.text-danger');
                        if (descMsg) descMsg.textContent = '';
                    } else if (!isOther && otherTextarea) {
                        var otherMsg = otherTextarea.closest('.mb-4').querySelector('.text-danger');
                        if (otherMsg) otherMsg.textContent = '';
                    }
                }
                // Initialize Description as required by default (no category selected yet)
                if (descTextarea) {
                    descTextarea.setAttribute('required', 'required');
                    descTextarea.setAttribute('aria-required', 'true');
                }
                category.addEventListener('change', toggle);
                toggle();
            }
        })();
    </script>
}
