@model DashboardViewModel
@{
    ViewData["Title"] = "LGU Dashboard";
    ViewData["PageTitle"] = "LGU Monitoring Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-speedometer2 me-2"></i>LGU Monitoring Dashboard
    </h1>
    <span class="badge bg-info-subtle text-info fs-6">@Model.CurrentRole</span>
</div>

<partial name="_DashboardSummary" model="Model" />

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Active Alerts</h5>
                <a asp-controller="Alerts" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentAlerts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>Canal</th>
                                    <th>Description</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model.RecentAlerts)
                                {
                                    <tr>
                                        <td>
                                            @{
                                                var sevClass = alert.Severity == "Critical" ? "danger" :
                                                    alert.Severity == "High" ? "warning" :
                                                    alert.Severity == "Medium" ? "info" : "secondary";
                                            }
                                            <span class="badge bg-@sevClass">@alert.Severity</span>
                                        </td>
                                        <td>@alert.Canal?.CanalName</td>
                                        <td class="small">@alert.Description</td>
                                        <td class="small text-muted">@(Math.Round((DateTime.UtcNow - alert.DetectedAt).TotalMinutes)) min ago</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">
                        <i class="bi bi-check-circle-fill me-2 text-success"></i>No active alerts
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between">
                <h5 class="mb-0"><i class="bi bi-journal-text me-2 text-warning"></i>Community Reports</h5>
                <a asp-controller="Reports" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentReports.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var report in Model.RecentReports)
                        {
                            <li class="list-group-item border-0 py-2">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="mb-1 fw-medium">@report.Title</h6>
                                        <small class="text-muted d-block">@report.Canal?.CanalName - @report.ReportType</small>
                                    </div>
                                    <span class="badge bg-info">@report.Status</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">No pending reports.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-bell-fill me-2"></i>Flood Risk Assessment</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentRiskAssessments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th>Score</th>
                                    <th>Level</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var risk in Model.RecentRiskAssessments)
                                {
                                    <tr>
                                        <td>@risk.Canal?.CanalName</td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar" role="progressbar" style="width: @(risk.RiskScore)%"></div>
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                var riskClass = risk.RiskLevel == "Critical" ? "danger" :
                                                    risk.RiskLevel == "High" ? "warning" :
                                                    risk.RiskLevel == "Moderate" ? "info" : "success";
                                            }
                                            <span class="badge bg-@riskClass">@risk.RiskLevel</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">No risk assessments available.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Latest Water Levels</h5>
            </div>
            <div class="card-body">
                @if (Model.LatestReadings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th>Water Level (m)</th>
                                    <th>Debris</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reading in Model.LatestReadings)
                                {
                                    <tr>
                                        <td class="fw-medium">@reading.Canal?.CanalName</td>
                                        <td class="small">@reading.WaterLevel</td>
                                        <td class="small">@reading.DebrisLevel%</td>
                                        <td class="small text-muted">@reading.RecordedAt.ToString("HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">No sensor readings available.</p>
                }
            </div>
        </div>
    </div>
</div>
