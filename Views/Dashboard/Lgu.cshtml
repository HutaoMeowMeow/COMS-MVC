@model DashboardViewModel
@{
    ViewData["Title"] = "LGU Dashboard";
    ViewData["PageTitle"] = "LGU Monitoring Dashboard";
}

<div class="page-head">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-speedometer2 me-2 page-icon"></i>LGU Monitoring Dashboard</h1>
        <p class="page-sub">Canals, sensors, flood risk, and incoming community reports for your city.</p>
    </div>
    <span class="badge bg-primary-subtle text-primary fs-6">@Model.CurrentRole</span>
</div>

<partial name="_DashboardSummary" model="Model" />

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Active Alerts</h5>
                <a asp-controller="Alerts" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentAlerts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>Canal</th>
                                    <th>Description</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model.RecentAlerts)
                                {
                                    <tr>
                                        <td>
                                            @Html.SeverityBadge(alert.Severity)
                                        </td>
                                        <td>@alert.Canal?.CanalName</td>
                                        <td class="small">@alert.Description</td>
                                        <td class="small text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(alert.DetectedAt).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(alert.DetectedAt) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(alert.DetectedAt)</time></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-check-circle", Title = "No active alerts", Message = "All monitored canals are within their normal range." })" />
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between">
                <h5 class="mb-0"><i class="bi bi-journal-text me-2 text-warning"></i>Community Reports</h5>
                <a asp-controller="Reports" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentReports.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var report in Model.RecentReports)
                        {
                            <li class="list-group-item border-0 py-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <h6 class="mb-1 fw-medium">@report.Title</h6>
                                        <small class="text-muted d-block">@(report.Canal?.CanalName ?? "Unassigned canal") · @report.ReportType</small>
                                    </div>
                                    @Html.StatusBadge(report.Status)
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-journal-check", Title = "No community reports", Message = "New resident reports will appear here for investigation." })" />
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-bell-fill me-2"></i>Flood Risk Assessment</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentRiskAssessments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th>Score</th>
                                    <th>Level</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var risk in Model.RecentRiskAssessments)
                                {
                                    <tr>
                                        <td>@risk.Canal?.CanalName</td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar" role="progressbar" style="width: @(risk.RiskScore)%"></div>
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                var riskClass = risk.RiskLevel == "Critical" ? "danger" :
                                                    risk.RiskLevel == "High" ? "warning" :
                                                    risk.RiskLevel == "Moderate" ? "info" : "success";
                                            }
                                            @Html.StatusBadge(risk.RiskLevel)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-shield-check", Title = "No risk assessments yet", Message = "Assessments appear after sensor readings are processed." })" />
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Latest Water Levels</h5>
            </div>
            <div class="card-body">
                @if (Model.LatestReadings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th>Water Level (m)</th>
                                    <th>Debris</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reading in Model.LatestReadings)
                                {
                                    <tr>
                                        <td class="fw-medium">@reading.Canal?.CanalName</td>
                                        <td class="small">@reading.WaterLevel</td>
                                        <td class="small">@reading.DebrisLevel%</td>
                                        <td class="small text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(reading.RecordedAt).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(reading.RecordedAt) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(reading.RecordedAt)</time></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-activity", Title = "No sensor readings yet", Message = "Readings appear once sensors report water levels." })" />
                }
            </div>
        </div>
    </div>
</div>




