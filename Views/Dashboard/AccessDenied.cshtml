@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="display-1 fw-bold text-warning mb-3">
                <i class="bi bi-shield-lock"></i> 403
            </div>
            <h2 class="mb-3">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have permission to access this resource. Please contact your administrator
                if you believe this is an error.
            </p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door me-2"></i>Return to Dashboard
            </a>
        </div>
    </div>
</div>
