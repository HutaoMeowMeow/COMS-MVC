@model DashboardViewModel
@{
    ViewData["Title"] = "Maintenance Dashboard";
    ViewData["PageTitle"] = "Maintenance Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-speedometer2 me-2"></i>Maintenance Dashboard
    </h1>
    <span class="badge bg-warning-subtle text-warning fs-6">@Model.CurrentRole</span>
</div>

<partial name="_DashboardSummary" model="Model" />

<div class="row g-4">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Your Assigned Alerts</h5>
                <a asp-controller="Alerts" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentAlerts.Any(a => a.AssignedToUser != null))
                {
                    var assignedAlerts = Model.RecentAlerts.Where(a => a.AssignedToUser != null).ToList();
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>Canal</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in assignedAlerts)
                                {
                                    <tr>
                                        <td>
                                            @{
                                                var sevClass = alert.Severity == "Critical" ? "danger" :
                                                    alert.Severity == "High" ? "warning" :
                                                    alert.Severity == "Medium" ? "info" : "secondary";
                                            }
                                            <span class="badge bg-@sevClass">@alert.Severity</span>
                                        </td>
                                        <td>@alert.Canal?.CanalName</td>
                                        <td class="fw-medium">@alert.Title</td>
                                        <td><span class="badge bg-secondary">@alert.Status</span></td>
                                        <td>
                                            <a asp-controller="Alerts" asp-action="Details" asp-route-id="@alert.ObstructionAlertId" class="btn btn-sm btn-outline-primary">Manage</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">
                        <i class="bi bi-check-circle-fill me-2 text-success"></i> No alerts assigned to you
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-journal-text me-2 text-warning"></i>Recent Community Reports</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentReports.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var report in Model.RecentReports)
                        {
                            <li class="list-group-item border-0 py-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-0 fw-medium">@report.Title</h6>
                                        <small class="text-muted d-block">@report.Canal?.CanalName - @report.ReportType</small>
                                    </div>
                                    <a asp-controller="Reports" asp-action="Details" asp-route-id="@report.CommunityReportId" class="btn btn-sm btn-outline-primary">View</a>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">No recent reports.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-water me-2"></i>Canal Conditions</h5>
            </div>
            <div class="card-body">
                @if (Model.LatestReadings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th>Water Level</th>
                                    <th>Debris</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reading in Model.LatestReadings)
                                {
                                    <tr>
                                        <td class="fw-medium">@reading.Canal?.CanalName</td>
                                        <td class="small">@reading.WaterLevel m</td>
                                        <td class="small">@reading.DebrisLevel%</td>
                                        <td>
                                            @{
                                                var warning = reading.Canal?.WarningWaterLevel ?? 999;
                                                var status = reading.WaterLevel >= warning ? "Warning" : "Normal";
                                                var statusColor = status == "Warning" ? "warning" : "success";
                                            }
                                            <span class="badge bg-@statusColor">@status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">No sensor data available.</p>
                }
            </div>
        </div>
    </div>
</div>
