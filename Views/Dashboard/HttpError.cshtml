@{
    ViewData["Title"] = "Page Not Found";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="display-1 fw-bold text-secondary mb-3">
                <i class="bi bi-exclamation-octagon"></i> 404
            </div>
            <h2 class="mb-3">Page Not Found</h2>
            <p class="text-muted mb-4">
                The page you are looking for does not exist or has been moved.
            </p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door me-2"></i>Return to Dashboard
            </a>
        </div>
    </div>
</div>
