@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="display-1 fw-bold text-danger mb-3">
                <i class="bi bi-bug"></i> 500
            </div>
            <h2 class="mb-3">Something Went Wrong</h2>
            <p class="text-muted mb-4">
                An unexpected error occurred while processing your request.
                Please try again later or contact your system administrator.
            </p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door me-2"></i>Return to Dashboard
            </a>
        </div>
    </div>
</div>
