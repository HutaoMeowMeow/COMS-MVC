@model DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["PageTitle"] = "System Management Dashboard";
}

<div class="page-head">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-speedometer2 me-2 page-icon"></i>System Management Dashboard</h1>
        <p class="page-sub">Whole-of-system view: canals, sensors, flood risk, reports, and announcements.</p>
    </div>
    <span class="badge bg-primary-subtle text-primary fs-6">@Model.CurrentRole</span>
</div>

<partial name="_DashboardSummary" model="Model" />

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Recent Alerts</h5>
                <a asp-controller="Alerts" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentAlerts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>Canal</th>
                                    <th>Title</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model.RecentAlerts)
                                {
                                    <tr>
                                        <td>
                                            @Html.SeverityBadge(alert.Severity)
                                        </td>
                                        <td>@alert.Canal?.CanalName</td>
                                        <td class="fw-medium">@alert.Title</td>
                                        <td class="small text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(alert.DetectedAt).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(alert.DetectedAt) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(alert.DetectedAt)</time></td>
                                        <td>
                                            @Html.StatusBadge(alert.Status)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-check-circle", Title = "No recent alerts", Message = "All monitored canals are within their normal range." })" />
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-journal-text me-2 text-warning"></i>Recent Reports</h5>
                <a asp-controller="Reports" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentReports.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in Model.RecentReports)
                                {
                                    <tr>
                                        <td>@(report.Canal?.CanalName ?? "—")</td>
                                        <td class="fw-medium">@report.Title</td>
                                        <td class="small">@report.ReportType</td>
                                        <td class="small text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(report.CreatedAt).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(report.CreatedAt) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(report.CreatedAt)</time></td>
                                        <td>
                                            @{
                                                var statusClass = report.Status switch
                                                {
                                                    "Resolved" => "success",
                                                    "In Progress" => "warning",
                                                    "Pending" => "secondary",
                                                    "Rejected" => "danger",
                                                    _ => "info"
                                                };
                                            }
                                            @Html.StatusBadge(report.Status)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-journal-check", Title = "No recent reports", Message = "New resident reports will appear here for review." })" />
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-water me-2"></i>Canal Status</h5>
            </div>
            <div class="card-body">
                @if (Model.CanalStatusOverview.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th>Barangay</th>
                                    <th>Status</th>
                                    <th>Sensors</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var canal in Model.CanalStatusOverview)
                                {
                                    <tr>
                                        <td class="fw-medium">@canal.CanalName</td>
                                        <td class="small">@canal.Barangay</td>
                                        <td>
                                            @{
                                                var statusColor = canal.Status switch
                                                {
                                                    "Normal" => "success",
                                                    "Warning" => "warning",
                                                    "Critical" => "danger",
                                                    "Inactive" => "secondary",
                                                    _ => "secondary"
                                                };
                                            }
                                            @Html.StatusBadge(canal.Status)
                                        </td>
                                        <td class="small text-muted">@canal.Sensors.Count(s => s.Status == "Online") online</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-water", Title = "No canals registered", Message = "Add a canal to begin monitoring.", ActionText = "Manage Canals", ActionController = "Canals", ActionName = "Index" })" />
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-bell-fill me-2"></i>Flood Risk Overview</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentRiskAssessments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Canal</th>
                                    <th>Risk Score</th>
                                    <th>Level</th>
                                    <th>Assessed</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var risk in Model.RecentRiskAssessments)
                                {
                                    <tr>
                                        <td class="fw-medium">@risk.Canal?.CanalName</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress me-2" style="width: 60px; height: 18px;">
                                                    <div class="progress-bar @GetRiskClass(risk.RiskLevel)" role="progressbar"
                                                         style="width: @(risk.RiskScore)%"></div>
                                                </div>
                                                <span class="small">@risk.RiskScore</span>
                                            </div>
                                        </td>
                                        <td>@Html.StatusBadge(risk.RiskLevel)</td>
                                        <td class="small text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(risk.AssessmentDate).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(risk.AssessmentDate) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(risk.AssessmentDate)</time></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-shield-check", Title = "No risk assessments yet", Message = "Assessments appear after sensor readings are processed." })" />
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Water Level Trend</h5>
            </div>
            <partial name="_WaterLevelTrendChart" />
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Sensor Status</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Sensor</th>
                                <th>Type</th>
                                <th>Canal</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.SensorStatus.Any())
                            {
                                <tr>
                                    <td colspan="4">
                                        <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-broadcast", Title = "No sensors registered", Message = "Sensor status appears once monitoring devices are added." })" />
                                    </td>
                                </tr>
                            }
                            @foreach (var sensor in Model.SensorStatus.Take(10))
                            {
                                <tr>
                                    <td class="fw-medium">@sensor.SensorCode</td>
                                    <td class="small">@sensor.SensorType</td>
                                    <td class="small">@sensor.Canal?.CanalName</td>
                                    <td>
                                        @{
                                            var sensorColor = sensor.Status switch
                                            {
                                                "Online" => "success",
                                                "Offline" => "danger",
                                                "Maintenance" => "warning",
                                                _ => "secondary"
                                            };
                                        }
                                        @Html.StatusBadge(sensor.Status)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-megaphone me-2"></i>Latest Announcements</h5>
            </div>
            <div class="card-body">
                @if (Model.Announcements.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var ann in Model.Announcements)
                        {
                            <li class="list-group-item border-0 py-2">
                                <div class="d-flex">
                                    @if (!string.IsNullOrEmpty(ann.ImagePath))
                                    {
                                        <img src="@ann.ImagePath" class="me-2 rounded" style="width: 40px; height: 40px; object-fit: cover;" alt="" loading="lazy" onerror="this.style.display='none'" />
                                    }
                                    <div>
                                        <h6 class="mb-1 fw-medium">@ann.Title</h6>
                                        <p class="text-muted small mb-0 text-truncate" style="max-width: 250px;">@ann.Content</p>
                                        <small class="text-muted"><time data-utc="@COMS_MVC.Helpers.PhTime.AsUtc(ann.CreatedAt).ToString("o")" title="@COMS_MVC.Helpers.PhTime.ToPhString(ann.CreatedAt) (Philippine time)">@COMS_MVC.Helpers.PhTime.ToRelative(ann.CreatedAt)</time></small>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "bi-megaphone", Title = "No announcements", Message = "Published announcements will appear here." })" />
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/water-trend.js" asp-append-version="true"></script>
}

@functions {
    private string GetRiskClass(string level)
    {
        return level switch
        {
            "Critical" => "bg-danger",
            "High" => "bg-warning",
            "Moderate" => "bg-info",
            "Low" => "bg-success",
            _ => "bg-secondary"
        };
    }
}



