@model DashboardViewModel
@{
    ViewData["Title"] = "Barangay Dashboard";
    ViewData["PageTitle"] = "Barangay Monitoring Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-speedometer2 me-2"></i>@(Model.UserBarangay != null ? Model.UserBarangay + " Barangay" : "Barangay") Dashboard
    </h1>
    <span class="badge bg-success-subtle text-success fs-6">@Model.CurrentRole</span>
</div>

<partial name="_DashboardSummary" model="Model" />

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Alerts in Your Jurisdiction</h5>
                <a asp-controller="Alerts" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentAlerts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>Canal</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Time</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model.RecentAlerts)
                                {
                                    <tr>
                                        <td>
                                            @{
                                                var sevClass = alert.Severity == "Critical" ? "danger" :
                                                    alert.Severity == "High" ? "warning" :
                                                    alert.Severity == "Medium" ? "info" : "secondary";
                                            }
                                            <span class="badge bg-@sevClass">@alert.Severity</span>
                                        </td>
                                        <td>@alert.Canal?.CanalName</td>
                                        <td class="fw-medium">@alert.Title</td>
                                        <td><span class="badge bg-@sevClass text-dark">@alert.Status</span></td>
                                        <td class="small text-muted">@(Math.Round((DateTime.UtcNow - alert.DetectedAt).TotalMinutes)) min ago</td>
                                        <td>
                                            <a asp-controller="Alerts" asp-action="Details" asp-route-id="@alert.ObstructionAlertId" class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">
                        <i class="bi bi-check-circle-fill me-2 text-success"></i> No active alerts in your area
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between">
                <h5 class="mb-0"><i class="bi bi-journal-text me-2 text-warning"></i>Community Reports</h5>
                <a asp-controller="Reports" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentReports.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var report in Model.RecentReports)
                        {
                            <li class="list-group-item border-0 py-2">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="mb-0 fw-medium">@report.Title</h6>
                                        <small class="text-muted">@report.Canal?.CanalName</small>
                                    </div>
                                    <span class="badge bg-secondary">@report.Status</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">No recent reports.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Water Level Trend</h5>
            </div>
            <div class="card-body">
                <canvas id="barangayChart" height="100"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var ctx = document.getElementById('barangayChart').getContext('2d');
            var chart = new Chart(ctx, {
                type: 'line',
                data: { labels: [], datasets: [{
                    label: 'Water Level (m)', data: [], borderColor: '#20c997',
                    backgroundColor: 'rgba(32, 201, 151, 0.1)', tension: 0.3, fill: true
                }]},
                options: { responsive: true, scales: { y: { beginAtZero: false } },
                    plugins: { legend: { display: false } } }
            });
            function loadData() {
                $.get('/SensorReadings/LatestReadingsJson', function (data) {
                    chart.data.labels = data.map(function (r) { return r.canalName; });
                    chart.data.datasets[0].data = data.map(function (r) { return r.waterLevel; });
                    chart.update();
                });
            }
            loadData();
            setInterval(loadData, 30000);
        });
    </script>
}
