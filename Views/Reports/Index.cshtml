@model IEnumerable<CommunityReport>
@{
    ViewData["Title"] = "Community Reports";
    ViewData["PageTitle"] = "Community Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-journal-text me-2 text-warning"></i>Community Reports
    </h1>
    @if (User.IsInRole("Resident"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-pencil-square me-1"></i>Report an Issue
        </a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Canal</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Submitted By</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td class="small">@report.CommunityReportId</td>
                                <td class="fw-medium">@report.Canal?.CanalName</td>
                                <td>@report.Title</td>
                                <td class="small">@report.ReportType</td>
                                <td class="small">@report.User?.FullName</td>
                                <td>
                                    @{
                                        var statusClass = report.Status switch
                                        {
                                            "Resolved" => "success",
                                            "In Progress" => "warning",
                                            "Pending" => "secondary",
                                            "Verified" => "info",
                                            "Rejected" => "danger",
                                            _ => "light text-dark"
                                        };
                                    }
                                    <span class="badge bg-@statusClass">@report.Status</span>
                                </td>
                                <td class="small text-muted">@(Math.Round((DateTime.UtcNow - report.CreatedAt).TotalDays, 0))d ago</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@report.CommunityReportId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-journal-text me-2"></i>No reports found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
