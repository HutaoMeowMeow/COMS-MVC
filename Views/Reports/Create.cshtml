@model CommunityReportFormViewModel
@{
    ViewData["Title"] = "Report an Issue";
    ViewData["PageTitle"] = "Report Canal Problem";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-pencil-square me-2"></i>Report a Canal Problem
    </h1>
    <a asp-action="MyReports" class="btn btn-outline-secondary">
        <i class="bi bi-folder2-open me-1"></i>My Reports
    </a>
</div>

<form asp-action="Create" enctype="multipart/form-data" method="post">
    @Html.AntiForgeryToken()
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Report Details</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CanalId" class="form-label"></label>
                    <select asp-for="CanalId" class="form-select" asp-items="(SelectList)ViewBag.CanalList">
                        <option value="">Select a canal</option>
                    </select>
                    <span asp-validation-for="CanalId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReportType" class="form-label"></label>
                    <select asp-for="ReportType" class="form-select" asp-items="(SelectList)ViewBag.ReportTypes">
                    </select>
                    <span asp-validation-for="ReportType" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Brief title for your report" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Describe the issue in detail..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Photo" class="form-label"></label>
                    <input asp-for="Photo" class="form-control" type="file" accept="image/*" />
                    <span asp-validation-for="Photo" class="text-danger small"></span>
                    <div class="form-text">Upload a photo (max 5MB, JPG/PNG/GIF)</div>
                </div>
                <div class="col-12">
                    <label class="form-label"><i class="bi bi-geo-alt me-1"></i>Exact Location (Cebu only)</label>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">Click the map or drag the pin to the exact area</span>
                        <button type="button" id="locateMeBtn" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-crosshair me-1"></i>Use my location
                        </button>
                    </div>
                    <div id="reportPickerMap" style="height: 350px;" class="rounded border"></div>
                    <span asp-validation-for="Latitude" class="text-danger small"></span>
                    <div class="row g-2 mt-2">
                        <div class="col-md-6">
                            <input asp-for="Latitude" class="form-control" type="number" step="0.000001" placeholder="Latitude e.g. 10.3157" readonly />
                        </div>
                        <div class="col-md-6">
                            <input asp-for="Longitude" class="form-control" type="number" step="0.000001" placeholder="Longitude e.g. 123.8854" readonly />
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="Landmark / street / sitio near the pin (optional)" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a asp-action="MyReports" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Cancel
        </a>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-send me-1"></i>Submit Report
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var latInput = document.getElementById('Latitude');
            var lngInput = document.getElementById('Longitude');
            // Cebu province bounds: lat 9.30-11.45, lng 123.20-124.60. Center: Cebu City.
            var cebuBounds = L.latLngBounds([9.30, 123.20], [11.45, 124.60]);
            var cebuCenter = [10.3157, 123.8854];
            var defaultLat = parseFloat(latInput.value) || cebuCenter[0];
            var defaultLng = parseFloat(lngInput.value) || cebuCenter[1];
            if (!cebuBounds.contains([defaultLat, defaultLng])) {
                defaultLat = cebuCenter[0];
                defaultLng = cebuCenter[1];
            }

            var map = L.map('reportPickerMap', {
                maxBounds: cebuBounds,
                maxBoundsViscosity: 1.0,
                minZoom: 9,
                maxZoom: 18
            }).setView([defaultLat, defaultLng], 11);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            var marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

            function inCebu(lat, lng) {
                return lat >= 9.30 && lat <= 11.45 && lng >= 123.20 && lng <= 124.60;
            }

            function syncInputs(lat, lng) {
                latInput.value = lat.toFixed(6);
                lngInput.value = lng.toFixed(6);
            }
            syncInputs(defaultLat, defaultLng);

            marker.on('dragend', function () {
                var pos = marker.getLatLng();
                if (!inCebu(pos.lat, pos.lng)) {
                    marker.setLatLng(cebuCenter);
                    alert('Please pick a location inside Cebu.');
                    return;
                }
                syncInputs(pos.lat, pos.lng);
                map.panTo(pos);
            });

            map.on('click', function (e) {
                if (!inCebu(e.latlng.lat, e.latlng.lng)) {
                    alert('That point is outside Cebu. Please pick a location inside Cebu.');
                    return;
                }
                marker.setLatLng(e.latlng);
                syncInputs(e.latlng.lat, e.latlng.lng);
            });

            var locateBtn = document.getElementById('locateMeBtn');
            if (locateBtn && navigator.geolocation) {
                locateBtn.addEventListener('click', function () {
                    navigator.geolocation.getCurrentPosition(function (pos) {
                        if (!inCebu(pos.coords.latitude, pos.coords.longitude)) {
                            alert('Your current location is outside Cebu. Please drag the pin to the site in Cebu.');
                            return;
                        }
                        var latlng = [pos.coords.latitude, pos.coords.longitude];
                        marker.setLatLng(latlng);
                        map.setView(latlng, 15);
                        syncInputs(pos.coords.latitude, pos.coords.longitude);
                    });
                });
            } else if (locateBtn) {
                locateBtn.disabled = true;
            }

            // If resident picks a canal, jump the pin to that canal when it is in Cebu.
            var canalCoords = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CanalCoords ?? new Dictionary<int, object>()));
            var canalSelect = document.getElementById('CanalId');
            if (canalSelect) {
                canalSelect.addEventListener('change', function () {
                    var entry = canalCoords[canalSelect.value];
                    if (entry) {
                        var lat = parseFloat(entry.lat);
                        var lng = parseFloat(entry.lng);
                        if (!isNaN(lat) && !isNaN(lng) && inCebu(lat, lng)) {
                            marker.setLatLng([lat, lng]);
                            map.setView([lat, lng], 14);
                            syncInputs(lat, lng);
                        }
                    }
                });
            }

            setTimeout(function () { map.invalidateSize(); }, 200);
        });
    </script>
}
