@model CommunityReport
@{
    ViewData["Title"] = "Report Details";
    ViewData["PageTitle"] = "Report Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0">
            <i class="bi bi-journal-text me-2 text-warning"></i>Report #@Model.CommunityReportId — @Model.Title
        </h1>
    </div>
    <span class="badge bg-@(Model.Status == "Resolved" ? "success" : Model.Status == "In Progress" ? "warning" : Model.Status == "Pending" ? "secondary" : Model.Status == "Rejected" ? "danger" : "info") fs-6">@Model.Status</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Report Details</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless table-sm">
                    <tbody>
                        <tr>
                            <th class="text-muted small">Canal</th>
                            <td>@Model.Canal?.CanalName — @Model.Canal?.Location</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Report Type</th>
                            <td>@Model.ReportType</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Status</th>
                            <td>
                                <span class="badge bg-@(Model.Status == "Resolved" ? "success" : Model.Status == "In Progress" ? "warning" : Model.Status == "Pending" ? "secondary" : Model.Status == "Rejected" ? "danger" : "info")">@Model.Status</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Location</th>
                            <td>@(Model.Location ?? "Not specified")</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Submitted By</th>
                            <td>@Model.User?.FullName (@Model.User?.UserName)</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Submitted</th>
                            <td>@Model.CreatedAt.ToString("g")</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Last Updated</th>
                            <td>@Model.UpdatedAt.ToString("g")</td>
                        </tr>
                    </tbody>
                </table>

                <div class="mt-3">
                    <label class="form-label fw-medium"><i class="bi bi-chat-text me-1"></i>Description</label>
                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            @Model.Description
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <div class="mt-3">
                        <label class="form-label fw-medium"><i class="bi bi-image me-1"></i>Photo</label>
                        <div>
                            <img src="@Model.PhotoPath" class="img-fluid rounded border" style="max-height: 300px;" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("LGU") || User.IsInRole("Barangay"))
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Update Report Status</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.CommunityReportId" />
                        <div class="mb-3">
                            <label class="form-label">New Status</label>
                            <select name="status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Under Review">Under Review</option>
                                <option value="Verified">Verified</option>
                                <option value="Assigned">Assigned</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Notes (optional)</label>
                            <textarea name="notes" class="form-control" rows="2"
                                      placeholder="Add notes about this status update..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Update Status
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        @if (User.IsInRole("Admin"))
        {
            <form asp-action="Delete" method="post" asp-route-id="@Model.CommunityReportId">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger w-100"
                        onclick="return confirm('Are you sure you want to delete this report?');">
                    <i class="bi bi-trash me-1"></i>Delete Report
                </button>
            </form>
        }
    </div>
</div>
