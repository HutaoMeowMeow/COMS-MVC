@{
    ViewData["Title"] = "COMS - Canal Obstruction Monitoring System";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <div class="mb-5">
                    <i class="bi bi-waterways display-1 text-primary mb-3"></i>
                    <h1 class="display-4 fw-bold mb-3">Canal Obstruction Monitoring System</h1>
                    <p class="lead text-muted">
                        An AI- and IoT-integrated canal monitoring and flood-risk management system
                        designed to help local government units, barangay officials, maintenance
                        personnel, and residents monitor canal conditions and prevent flooding.
                    </p>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4">
                                <i class="bi bi-graph-up-arrow display-5 text-primary mb-3"></i>
                                <h5 class="card-title">Real-time Monitoring</h5>
                                <p class="card-text text-muted small">
                                    Monitor water levels, flow rates, and debris levels through IoT sensors.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4">
                                <i class="bi bi-exclamation-triangle-fill display-5 text-warning mb-3"></i>
                                <h5 class="card-title">Alert System</h5>
                                <p class="card-text text-muted small">
                                    Automated alerts for abnormal conditions and potential obstructions.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4">
                                <i class="bi bi-bell-fill display-5 text-info mb-3"></i>
                                <h5 class="card-title">Flood Risk Assessment</h5>
                                <p class="card-text text-muted small">
                                    Rule-based flood risk scoring and real-time notifications.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5">
                        Sign In
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-5">
                        Register
                    </a>
                </div>

                <div class="mt-4">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Demo accounts: admin@coms.gov / COMS_Demo123!
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
