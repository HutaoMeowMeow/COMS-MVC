@{
    ViewData["Title"] = "Password Reset";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center">
                        <h2 class="mb-2">Password Reset</h2>
                        <p class="text-muted small mb-4">Your password has been reset. You can now sign in with your new password.</p>
                        <a asp-action="Login" class="btn btn-primary w-100">Sign in</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
