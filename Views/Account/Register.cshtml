@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

@section Styles {
<style>
    .register-page {
        min-height: 100vh;
        margin: -1.5rem;
        padding: 2.5rem 1rem;
        background:
            radial-gradient(1000px 500px at 10% 10%, rgba(49,130,206,.35), transparent 60%),
            radial-gradient(800px 500px at 90% 90%, rgba(30,58,95,.5), transparent 60%),
            linear-gradient(135deg, #102a43 0%, #1e3a5f 45%, #2c5282 100%);
        display: flex;
        align-items: center;
        animation: authFadeIn .35s ease both;
    }
    .register-card {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 25px 60px rgba(0,0,0,.35);
        animation: cardRise .4s ease both;
    }
    .register-card .form-control:focus, .register-card .form-select:focus {
        border-color: #3182ce;
        box-shadow: 0 0 0 .2rem rgba(49,130,206,.22);
    }
    .register-card .form-control, .register-card .form-select {
        border-radius: .65rem;
        padding: .65rem .9rem;
    }
    .register-submit {
        border-radius: .65rem;
        padding: .7rem;
        font-weight: 600;
        background: linear-gradient(135deg, #2b6cb0 0%, #3182ce 100%);
        border: 0;
        box-shadow: 0 8px 20px rgba(49,130,206,.4);
        transition: filter .15s ease, transform .15s ease;
    }
    .register-submit:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-1px); }
    @@keyframes authFadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes cardRise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) {
        .register-page, .register-card { animation: none; }
    }
</style>
}

<div class="register-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="card register-card">
                    <div class="card-body p-4 p-lg-5">
                        <div class="text-center mb-4">
                            <img src="~/images/COMS-LOGO.png" alt="COMS logo" style="height: 64px; width: auto;" asp-append-version="true" />
                            <h2 class="mt-3 mb-1 fw-bold">Create your account</h2>
                            <p class="text-muted small mb-0">Canal Obstruction Maintenance System</p>
                            <p class="text-muted small mt-2 mb-0">
                                <i class="bi bi-envelope-check me-1"></i>We&apos;ll email you a 6-digit code to verify your address.
                            </p>
                        </div>

                        <form asp-action="Register" method="post" id="registerForm">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small mb-3 py-2" })
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-semibold small"></label>
                                    <input asp-for="FullName" class="form-control" placeholder="Maria Santos" autocomplete="name" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="UserName" class="form-label fw-semibold small"></label>
                                    <input asp-for="UserName" class="form-control" placeholder="Username" autocomplete="username" />
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3 mt-3">
                                <label asp-for="Email" class="form-label fw-semibold small"></label>
                                <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+63 912 345 6789" autocomplete="tel" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Barangay" class="form-label fw-semibold small"></label>
                                    <input asp-for="Barangay" class="form-control" placeholder="Barangay" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="City" class="form-label fw-semibold small"></label>
                                    <input asp-for="City" class="form-control" placeholder="City / Municipality" />
                                </div>
                            </div>

                            <div class="mb-3 mt-3">
                                <label asp-for="Address" class="form-label fw-semibold small"></label>
                                <input asp-for="Address" class="form-control" placeholder="Complete Address" autocomplete="street-address" />
                            </div>

                            @if (ViewBag.AvailableRoles != null)
                            {
                                <div class="mb-3">
                                    <label asp-for="Role" class="form-label fw-semibold small"></label>
                                    <select asp-for="Role" class="form-select"
                                            asp-items="ViewBag.AvailableRoles"></select>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" asp-for="Role" value="Resident" />
                            }

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <input asp-for="Password" class="form-control" id="regPassword" type="password" placeholder="Password" autocomplete="new-password" />
                                    <button type="button" class="btn btn-outline-secondary pwd-toggle" data-target="regPassword" title="Show / hide password" aria-label="Show password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="form-text small text-muted">At least 6 characters, with 1 uppercase, 1 lowercase, 1 number, and 1 special character (e.g. !@@#$%).</div>
                            </div>
                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <input asp-for="ConfirmPassword" class="form-control" id="regConfirm" type="password" placeholder="Confirm Password" autocomplete="new-password" />
                                    <button type="button" class="btn btn-outline-secondary pwd-toggle" data-target="regConfirm" title="Show / hide password" aria-label="Show password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 register-submit" id="registerBtn">
                                <span class="btn-label"><i class="bi bi-person-plus me-2"></i>Register &amp; send code</span>
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            </button>
                        </form>

                        <div class="text-center mt-4 pt-3 border-top">
                            <p class="mb-0 small">
                                Already have an account?
                                <a asp-action="Login" class="text-decoration-none fw-semibold">Sign in</a>
                            </p>
                        </div>
                    </div>
                </div>
                <p class="text-center text-white-50 small mt-3 mb-0">
                    <i class="bi bi-shield-lock me-1"></i>Protected by role-based access — Admin, LGU, Barangay, Maintenance &amp; Resident
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.pwd-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.getAttribute('data-target'));
                    if (!input) return;
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                });
            });
            var form = document.getElementById('registerForm');
            var submit = document.getElementById('registerBtn');
            if (form && submit) {
                form.addEventListener('submit', function () {
                    if (!form.checkValidity()) return;
                    submit.disabled = true;
                    submit.querySelector('.btn-label').classList.add('opacity-50');
                    submit.querySelector('.spinner-border').classList.remove('d-none');
                });
            }
        });
    </script>
}
