@model EnableTwoFactorViewModel
@{
    ViewData["Title"] = "Set Up Two-Factor Authentication";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <h3 class="fw-bold mb-1">Set up two-factor authentication</h3>
                    <p class="text-muted small mb-4">
                        Scan the QR code with an authenticator app such as Google Authenticator,
                        Microsoft Authenticator, or Authy. Then enter the 6-digit code shown by the app.
                    </p>

                    @if (TempData["ErrorMessage"] is string error)
                    {
                        <div class="alert alert-danger small py-2">@error</div>
                    }

                    <div class="row g-4 align-items-start">
                        <div class="col-12 col-md-5 text-center">
                            @if (!string.IsNullOrWhiteSpace(Model.QrCodeUrl))
                            {
                                <img src="@Model.QrCodeUrl" alt="QR code for authenticator setup"
                                     class="img-fluid border rounded p-2 bg-white"
                                     style="max-width: 240px;" />
                            }
                            else
                            {
                                <div class="alert alert-warning small">
                                    The QR code could not be generated. Use the setup key below.
                                </div>
                            }
                        </div>

                        <div class="col-12 col-md-7">
                            <div class="mb-3">
                                <div class="small fw-semibold mb-1">Manual setup key</div>
                                <div class="input-group">
                                    <input id="sharedKey" class="form-control font-monospace" value="@Model.SharedKey" readonly />
                                    <button type="button" class="btn btn-outline-secondary" id="copyKeyBtn">Copy</button>
                                </div>
                                <div class="form-text">
                                    If your app asks for details, choose time-based (TOTP), 6 digits, 30 seconds.
                                </div>
                            </div>

                            <form asp-action="EnableTwoFactor" method="post" autocomplete="off">
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2" })

                                <div class="mb-3">
                                    <label asp-for="Code" class="form-label fw-semibold small"></label>
                                    <input asp-for="Code"
                                           class="form-control form-control-lg text-center font-monospace"
                                           inputmode="numeric"
                                           autocomplete="one-time-code"
                                           maxlength="6"
                                           placeholder="123456"
                                           autofocus />
                                    <span asp-validation-for="Code" class="text-danger small"></span>
                                </div>

                                <div class="alert alert-info small">
                                    After verification, you will receive recovery codes. Store them somewhere safe;
                                    each code can be used once if you lose access to your authenticator.
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-shield-check me-1"></i>Verify and Enable
                                    </button>
                                    <a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('copyKeyBtn')?.addEventListener('click', function () {
            var input = document.getElementById('sharedKey');
            if (!input) return;
            input.select();
            input.setSelectionRange(0, input.value.length);
            navigator.clipboard?.writeText(input.value);
            this.textContent = 'Copied';
            setTimeout(() => { this.textContent = 'Copy'; }, 1500);
        });
    </script>
}
