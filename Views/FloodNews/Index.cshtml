@model FloodNewsResult
@{
    ViewData["Title"] = "Flood News";
    ViewData["PageTitle"] = "Flood News";
    var updatedAgo = DateTimeOffset.UtcNow - Model.FetchedAtUtc;
    var updatedText = updatedAgo.TotalMinutes < 1 ? "just now"
        : updatedAgo.TotalMinutes < 60 ? $"{(int)updatedAgo.TotalMinutes} minute(s) ago"
        : $"{(int)updatedAgo.TotalHours} hour(s) ago";
    // Philippine time is UTC+8 year-round (no DST): fixed offset, no TZ-DB dependency.
    string PhTime(DateTimeOffset? value)
    {
        if (!value.HasValue) return "Recent";
        var ph = value.Value.UtcDateTime.AddHours(8);
        var todayPh = DateTime.UtcNow.AddHours(8).Date;
        return ph.Date == todayPh
            ? "Today, " + ph.ToString("h:mm tt")
            : ph.ToString("MMM d, yyyy · h:mm tt");
    }
}

<div class="page-head">
    <div>
        <h1 class="h3"><i class="bi bi-newspaper me-2 page-icon"></i>Flood News</h1>
        <p class="page-sub">Recent flood-related news for the Philippines. Informational only — not a flood warning.</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a asp-action="Index" asp-route-refresh="true" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </a>
        <span class="badge bg-light text-dark border" title="Last successful fetch">
            <i class="bi bi-arrow-clockwise me-1"></i>Updated @updatedText
        </span>
    </div>
</div>

@if (Model.IsUnavailable)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-cloud-slash display-1 text-muted mb-3"></i>
            <h4 class="text-muted">Flood news is temporarily unavailable.</h4>
            <p class="text-muted">The system will refresh news automatically. Please try again later.</p>
            <a asp-controller="FloodRisk" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-tsunami me-1"></i>Back to Flood Risk
            </a>
        </div>
    </div>
}
else
{
    @if (Model.IsStale)
    {
        <div class="alert alert-warning small" role="status">
            <i class="bi bi-exclamation-triangle me-1"></i>Showing cached news — the provider could not be reached. Updated @updatedText.
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0"><i class="bi bi-bar-chart me-2 text-primary"></i>Flood News Trends</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 text-center">
                <div class="col-6 col-md-4">
                    <div class="stat-num">@Model.Trends.Last24Hours</div>
                    <div class="stat-label">Last 24 hours</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="stat-num">@Model.Trends.Last7Days</div>
                    <div class="stat-label">Last 7 days</div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="stat-label mb-2">Frequently mentioned areas</div>
                    @if (Model.Trends.TopAreas.Any())
                    {
                        @foreach (var area in Model.Trends.TopAreas)
                        {
                            <span class="badge bg-info-subtle text-info me-1 mb-1">@area</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }
                </div>
            </div>
            <p class="text-muted small mb-0 mt-3">
                <i class="bi bi-info-circle me-1"></i>Article frequency is informational only and does not indicate flood severity.
            </p>
        </div>
    </div>

    @if (Model.Articles.Any())
    {
        <div class="row g-4">
            @foreach (var article in Model.Articles)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary-subtle text-primary">@article.Source</span>
                                <small class="text-muted">@PhTime(article.PublishedAt)</small>
                            </div>
                            <h5 class="card-title">@article.Title</h5>
                            @if (!string.IsNullOrEmpty(article.Snippet))
                            {
                                <p class="card-text text-muted small flex-grow-1">@article.Snippet</p>
                            }
                            @if (article.AffectedAreas.Any())
                            {
                                <div class="mb-2">
                                    <small class="text-muted me-1">Affected areas:</small>
                                    @foreach (var area in article.AffectedAreas)
                                    {
                                        <span class="badge bg-info-subtle text-info me-1 mb-1">@area</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-top">
                            <a href="@article.Url" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                Read more<i class="bi bi-box-arrow-up-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-newspaper display-1 text-muted mb-3"></i>
                <h4 class="text-muted">No recent Philippine flood news available.</h4>
                <p class="text-muted">The system will refresh news automatically. Please check back later.</p>
                <a asp-controller="FloodRisk" asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-tsunami me-1"></i>Back to Flood Risk
                </a>
            </div>
        </div>
    }
}
