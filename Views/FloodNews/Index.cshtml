@model FloodNewsResult
@{
    ViewData["Title"] = "Flood News";
    ViewData["PageTitle"] = "Flood News";
    var updatedAgo = DateTimeOffset.UtcNow - Model.FetchedAtUtc;
    var updatedText = updatedAgo.TotalMinutes < 1 ? "just now"
        : updatedAgo.TotalMinutes < 60 ? $"{(int)updatedAgo.TotalMinutes} minute(s) ago"
        : $"{(int)updatedAgo.TotalHours} hour(s) ago";
    // Philippine time is UTC+8 year-round (no DST): fixed offset, no TZ-DB dependency.
    string PhTime(DateTimeOffset? value)
    {
        if (!value.HasValue) return "Recent";
        var ph = value.Value.UtcDateTime.AddHours(8);
        var todayPh = DateTime.UtcNow.AddHours(8).Date;
        return ph.Date == todayPh
            ? "Today, " + ph.ToString("h:mm tt")
            : ph.ToString("MMM d, yyyy · h:mm tt");
    }
}

<div class="page-head">
    <div>
        <h1 class="h3"><i class="bi bi-newspaper me-2 page-icon"></i>Flood News</h1>
        <p class="page-sub">Verified Philippine flood, drainage, and canal news only. Informational — not a flood warning.</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        @if ((ViewBag.Sources as List<string>)?.Any() == true)
        {
            <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center">
                <label class="visually-hidden" for="sourceFilter">Filter by source</label>
                <select id="sourceFilter" name="source" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Sources</option>
                    @foreach (var s in (List<string>)ViewBag.Sources)
                    {
                        @if (string.Equals(s, (string?)ViewBag.CurrentSource, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </form>
        }
        <a asp-action="Index" asp-route-refresh="true" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </a>
        <span class="badge bg-light text-dark border" title="Last successful fetch">
            <i class="bi bi-clock-history me-1"></i>Updated @updatedText
        </span>
    </div>
</div>

<div class="alert alert-info d-flex gap-2 align-items-start" role="note">
    <i class="bi bi-funnel mt-1" aria-hidden="true"></i>
    <div>
        <strong>Strictly filtered.</strong>
        Articles are shown only when Philippine flooding, drainage obstruction, canal conditions, or flood-prevention work is the subject.
        General national news, politics, entertainment, sports, foreign news, and unverified social-media posts are excluded.
    </div>
</div>

@if (Model.IsUnavailable)
{
    <div class="card border-0 shadow-sm">
        <partial name="_EmptyState" model="@(new EmptyStateViewModel {
            Icon = "bi-cloud-slash",
            Title = "Flood news is temporarily unavailable",
            Message = "The verified news sources could not be reached. The system will retry automatically; nothing unverified is shown in the meantime.",
            ActionText = "Back to Flood Risk",
            ActionController = "FloodRisk",
            ActionName = "Index"
        })" />
    </div>
}
else
{
    @if (Model.IsStale)
    {
        <div class="alert alert-warning small" role="status">
            <i class="bi bi-exclamation-triangle me-1"></i>Showing the last verified set — a provider could not be reached. Updated @updatedText.
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stat-card" style="--i:0">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon stat-tint-blue"><i class="bi bi-newspaper"></i></span>
                    <div>
                        <div class="stat-num">@Model.Trends.Last24Hours</div>
                        <div class="stat-label">Last 24 hours</div>
                        <div class="stat-sub">Qualifying articles</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card" style="--i:1">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon stat-tint-green"><i class="bi bi-calendar-week"></i></span>
                    <div>
                        <div class="stat-num">@Model.Trends.Last7Days</div>
                        <div class="stat-label">Last 7 days</div>
                        <div class="stat-sub">Qualifying articles</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card stat-card" style="--i:2">
                <div class="card-body">
                    <div class="stat-label mb-2">Frequently mentioned areas</div>
                    @if (Model.Trends.TopAreas.Any())
                    {
                        @foreach (var area in Model.Trends.TopAreas)
                        {
                            <span class="badge bg-info-subtle text-info me-1 mb-1">@area</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">No qualifying areas yet.</span>
                    }
                    <div class="stat-sub mt-2">Article frequency only — never a flood-severity score.</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Articles.Any())
    {
        <div class="row g-4">
            @foreach (var article in Model.Articles)
            {
                <div class="col-12 col-md-6 col-xl-4 d-flex">
                    <article class="card news-card h-100 w-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-2 flex-wrap">
                                <span class="d-flex gap-1 flex-wrap">
                                    <span class="badge bg-primary-subtle text-primary">@article.Source</span>
                                    @if (article.IsOfficial)
                                    {
                                        <span class="badge bg-success-subtle text-success" title="Official government/disaster data">
                                            <i class="bi bi-patch-check me-1"></i>Official data
                                        </span>
                                    }
                                </span>
                                <small class="text-muted">@PhTime(article.PublishedAt)</small>
                            </div>
                            <h2 class="h6 news-title mb-2">@article.Title</h2>
                            <div class="mb-2">
                                @if (article.Kind == "Advisory")
                                {
                                    <span class="badge bg-warning-subtle text-warning" title="Forecast, warning, or advisory — not a confirmed incident">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Advisory / Forecast
                                    </span>
                                }
                                else if (article.Kind == "Prevention")
                                {
                                    <span class="badge bg-success-subtle text-success" title="Drainage rehabilitation, canal cleaning, or flood-prevention work">
                                        <i class="bi bi-tools me-1"></i>Prevention / project
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info" title="Reported flood or drainage incident">
                                        <i class="bi bi-water me-1"></i>Incident report
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(article.Snippet))
                            {
                                <p class="card-text text-muted small flex-grow-1">@article.Snippet</p>
                            }
                            @if (article.AffectedAreas.Any())
                            {
                                <div class="mb-2">
                                    <small class="text-muted me-1">Locations:</small>
                                    @foreach (var area in article.AffectedAreas)
                                    {
                                        <span class="badge bg-info-subtle text-info me-1 mb-1">@area</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-top">
                            <a href="@article.Url" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                Read on @article.Source<i class="bi bi-box-arrow-up-right ms-1"></i>
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <partial name="_EmptyState" model="@(new EmptyStateViewModel {
                Icon = "bi-newspaper",
                Title = "No verified relevant flood news right now",
                Message = "No Philippine flood, drainage, or canal article currently meets COMS relevance and source-verification requirements. Unrelated news is never shown to fill this page. Use Refresh later or check back automatically.",
                ActionText = "Back to Flood Risk",
                ActionController = "FloodRisk",
                ActionName = "Index"
            })" />
        </div>
    }
}
