@model Announcement
@{
    ViewData["Title"] = "Delete Announcement";
    ViewData["PageTitle"] = "Delete Announcement";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-danger"><i class="bi bi-trash me-2"></i>Delete Announcement</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <strong>Warning:</strong> This action will permanently delete this announcement. This operation cannot be undone.
</div>

<form asp-action="Delete" method="post" asp-route-id="@Model.AnnouncementId">
    @Html.AntiForgeryToken()
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-danger bg-opacity-10 border-bottom">
            <h5 class="mb-0 text-danger"><i class="bi bi-megaphone me-2"></i>Announcement Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4 text-muted">Title</dt>
                <dd class="col-sm-8 mb-2">@Model.Title</dd>
                <dt class="col-sm-4 text-muted">Audience</dt>
                <dd class="col-sm-8 mb-2">@Model.TargetAudience</dd>
                <dt class="col-sm-4 text-muted">Location</dt>
                <dd class="col-sm-8 mb-2">@(Model.Location ?? "All Areas")</dd>
                <dt class="col-sm-4 text-muted">Posted By</dt>
                <dd class="col-sm-8 mb-2">@Model.PostedBy?.FullName</dd>
                <dt class="col-sm-4 text-muted">Created</dt>
                <dd class="col-sm-8 mb-2">@Model.CreatedAt.ToString("g")</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Cancel
        </a>
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>Delete Announcement
        </button>
    </div>
</form>
