@model Announcement
@{
    ViewData["Title"] = Model.Title;
    ViewData["PageTitle"] = "Announcement";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0">
            <i class="bi bi-megaphone me-2"></i>@Model.Title
        </h1>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("LGU"))
    {
        <div>
            <a asp-action="Edit" asp-route-id="@Model.AnnouncementId" class="btn btn-outline-warning">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.AnnouncementId" class="btn btn-outline-danger ms-2">
                <i class="bi bi-trash me-1"></i>Delete
            </a>
        </div>
    }
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex gap-3 mb-3">
            <span class="badge bg-info-subtle text-info fs-6">
                <i class="bi bi-bullseye me-1"></i>@Model.TargetAudience
            </span>
            <span class="badge bg-secondary fs-6">
                <i class="bi bi-geo-alt me-1"></i>@(Model.Location ?? "All Areas")
            </span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" class="img-fluid rounded mb-3" style="max-height: 300px; width: 100%; object-fit: cover;"
                 alt="@Model.Title" onerror="this.style.display='none'" />
        }

        <div class="mt-3">@Html.Raw(Html.Encode(Model.Content ?? string.Empty).Replace("\n", "<br/>"))</div>

        <div class="border-top pt-3 mt-3">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    <i class="bi bi-person me-1"></i>Posted by: @Model.PostedBy?.FullName
                </small>
                <small class="text-muted">
                    <i class="bi bi-clock me-1"></i>@Model.CreatedAt.ToString("MMM dd, yyyy 'at' HH:mm")
                </small>
            </div>
        </div>
    </div>
</div>
