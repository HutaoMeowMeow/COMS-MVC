@model IEnumerable<Canal>
@{
    ViewData["Title"] = "Canals";
    ViewData["PageTitle"] = "Canal Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-water me-2"></i>Canal Management
    </h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Canal
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Canal Name</th>
                        <th>Location</th>
                        <th>Barangay / City</th>
                        <th>Status</th>
                        <th>Sensors</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var canal in Model)
                    {
                        <tr>
                            <td class="fw-medium">@canal.CanalName</td>
                            <td class="small">@canal.Location</td>
                            <td class="small">
                                @canal.Barangay<br />
                                <span class="text-muted">@canal.City</span>
                            </td>
                            <td>
                                @{
                                    var statusClass = canal.Status switch
                                    {
                                        "Normal" => "success",
                                        "Warning" => "warning",
                                        "Critical" => "danger",
                                        "Inactive" => "secondary",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@statusClass">@canal.Status</span>
                            </td>
                            <td class="small text-muted">
                                @canal.Sensors.Count(s => s.Status == "Online") online / @canal.Sensors.Count total
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@canal.CanalId" class="btn btn-outline-primary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@canal.CanalId" class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@canal.CanalId" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-water fs-1 text-muted mb-3"></i>
                <h4 class="text-muted">No canals registered</h4>
                <p class="text-muted">Get started by adding your first canal.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Add First Canal
                    </a>
                }
            </div>
        }
    </div>
</div>
