@model IEnumerable<CanalMonitorItem>
@functions {
    static string StatusKey(string? status) => (status ?? "").Trim().ToLowerInvariant() switch
    {
        "normal" => "normal",
        "warning" => "warning",
        "critical" => "critical",
        "inactive" => "inactive",
        _ => "unknown"
    };

    static string StatusIcon(string key) => key switch
    {
        "normal" => "bi-check-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "critical" => "bi-exclamation-octagon-fill",
        "inactive" => "bi-pause-circle-fill",
        _ => "bi-question-circle-fill"
    };
}
@{
    ViewData["Title"] = "Canal Monitoring";
    ViewData["PageTitle"] = "Canal Monitoring";
    var items = Model.ToList();
    var knownStatuses = new[] { "Normal", "Warning", "Critical", "Inactive" };
    // Always show the four standard statuses, then any other lookup values present.
    var statusCounts = knownStatuses
        .Select(s => (Label: s, Count: items.Count(i => StatusKey(i.Status) == StatusKey(s))))
        .Concat(items.Where(i => StatusKey(i.Status) == "unknown")
            .GroupBy(i => string.IsNullOrWhiteSpace(i.Status) ? "Unknown" : i.Status.Trim())
            .OrderBy(g => g.Key)
            .Select(g => (Label: g.Key, Count: g.Count())))
        .ToList();
    var sensorTotal = items.Sum(i => i.SensorTotal);
    var sensorOnline = items.Sum(i => i.SensorOnline);
    var alertTotal = items.Sum(i => i.ActiveAlertCount);
    var canalsJson = System.Text.Json.JsonSerializer.Serialize(items,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/canal-monitor.css" asp-append-version="true" />
}

<div class="canal-monitor" id="canalMonitor" data-details-url="@Url.Action("Details", "Canals")">
    <header class="cm-header">
        <div>
            <h1 class="cm-title"><i class="bi bi-broadcast-pin me-2" aria-hidden="true"></i>Canal Monitoring</h1>
            <p class="cm-subtitle">Monitor registered canals, their sensors and active alerts across Cebu.</p>
        </div>
        @if (User.IsInRole("Admin") || !User.IsInRole("LGU"))
        {
            <a asp-action="Index" class="btn btn-outline-secondary cm-btn">
                <i class="bi bi-list-ul me-1" aria-hidden="true"></i>Canal list
            </a>
        }
    </header>

    <div class="cm-stats" role="status" aria-label="Monitoring summary">
        <div class="cm-stat">
            <i class="bi bi-water cm-stat-icon" aria-hidden="true"></i>
            <span class="cm-stat-value">@items.Count</span>
            <span class="cm-stat-label">@(items.Count == 1 ? "Canal" : "Canals")</span>
        </div>
        @foreach (var s in statusCounts)
        {
            var key = StatusKey(s.Label);
            <div class="cm-stat">
                <i class="bi @StatusIcon(key) cm-stat-icon cm-tone-@key" aria-hidden="true"></i>
                <span class="cm-stat-value">@s.Count</span>
                <span class="cm-stat-label">@s.Label</span>
            </div>
        }
        <div class="cm-stat">
            <i class="bi bi-cpu cm-stat-icon" aria-hidden="true"></i>
            <span class="cm-stat-value">@sensorOnline<span class="cm-stat-sub" aria-hidden="true"> / @sensorTotal</span><span class="visually-hidden"> of @sensorTotal</span></span>
            <span class="cm-stat-label">Sensors online</span>
        </div>
        <div class="cm-stat">
            <i class="bi bi-bell-fill cm-stat-icon @(alertTotal > 0 ? "cm-tone-critical" : null)" aria-hidden="true"></i>
            <span class="cm-stat-value">@alertTotal</span>
            <span class="cm-stat-label">Active @(alertTotal == 1 ? "alert" : "alerts")</span>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <section class="cm-card cm-map-card" aria-labelledby="cmMapTitle">
                <h2 id="cmMapTitle" class="visually-hidden">Canal map</h2>
                <div class="cm-map-wrap">
                    <div id="monitoringMap" class="cm-map" role="region" aria-label="Map of canals in Cebu. Use the canal list to select a canal with the keyboard."></div>
                    <div id="cmMapOverlay" class="cm-map-overlay" role="status">
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        <span>Loading map&hellip;</span>
                    </div>
                </div>
                <ul class="cm-legend" aria-label="Map legend">
                    <li><span class="cm-swatch cm-fill-normal" aria-hidden="true"></span>Normal</li>
                    <li><span class="cm-swatch cm-fill-warning" aria-hidden="true"></span>Warning</li>
                    <li><span class="cm-swatch cm-fill-critical" aria-hidden="true"></span>Critical</li>
                    <li><span class="cm-swatch cm-fill-inactive" aria-hidden="true"></span>Inactive / other</li>
                    <li><span class="cm-swatch cm-swatch-ring" aria-hidden="true"></span>Has active alerts</li>
                </ul>
            </section>
        </div>

        <div class="col-12 col-lg-4 cm-panel-col">
            <section class="cm-card cm-panel" aria-label="Canal information">
                <div id="cmListView" class="cm-view">
                    <div class="cm-panel-head">
                        <h2 class="cm-panel-title">Canals</h2>
                        <span class="cm-muted small">@items.Count total</span>
                    </div>
                    @if (items.Any())
                    {
                        <div class="cm-search">
                            <label for="cmSearch" class="form-label small mb-1">Search by name, barangay or status</label>
                            <input type="search" id="cmSearch" class="form-control" autocomplete="off" />
                        </div>
                        <ul id="cmList" class="cm-list" aria-label="Canal list"></ul>
                        <p id="cmNoMatch" class="cm-muted small px-3 py-2 mb-0" hidden>No canals match your search.</p>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-water fs-2 d-block mb-2" aria-hidden="true"></i>
                            <h3 class="h6">No canals registered</h3>
                            <p class="mb-0">There are no canals to monitor yet.</p>
                        </div>
                    }
                </div>
                <div id="cmDetailView" class="cm-view" hidden>
                    <div class="cm-panel-head">
                        <button type="button" id="cmBack" class="btn btn-outline-secondary btn-sm cm-btn">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>All canals
                        </button>
                    </div>
                    <div id="cmDetail" class="cm-detail"></div>
                </div>
                <p id="cmLive" class="visually-hidden" aria-live="polite"></p>
            </section>
        </div>
    </div>
</div>

@* The serializer's default encoder escapes <, > and quotes, so the data cannot close this tag. *@
<script type="application/json" id="canalMonitorData">@Html.Raw(canalsJson)</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/cebu-map.js" asp-append-version="true"></script>
    <script src="~/js/canal-monitor.js" asp-append-version="true"></script>
}
