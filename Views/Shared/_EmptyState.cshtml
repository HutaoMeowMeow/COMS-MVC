@model EmptyStateViewModel

<div class="empty-state">
    <div class="empty-icon"><i class="bi @Model.Icon"></i></div>
    <h6>@Model.Title</h6>
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <p>@Model.Message</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionName))
    {
        <a asp-action="@Model.ActionName" asp-controller="@Model.ActionController" class="btn btn-primary">
            @Model.ActionText
        </a>
    }
</div>
