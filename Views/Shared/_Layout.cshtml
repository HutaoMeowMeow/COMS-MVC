<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="COMS - Canal Obstruction Maintenance System" />
    <title>@ViewData["Title"] - COMS</title>
    <link rel="icon" type="image/png" href="~/images/COMS-LOGO.png" asp-append-version="true" />
    <script>
        // Anonymous (logged-out) pages such as Login stay on the light theme:
        // the flag is rendered server-side from the auth cookie, so no
        // localStorage value is read or deleted here.
        window.COMS_FORCE_LIGHT_THEME = @(User.Identity?.IsAuthenticated == true ? "false" : "true");
        // Apply saved/OS theme before first paint to avoid a flash of the wrong theme.
        // Stores only the non-sensitive "coms-theme" value ("light" | "dark").
        (function () {
            try {
                var theme = "light";
                if (window.COMS_FORCE_LIGHT_THEME !== true) {
                    var stored = window.localStorage.getItem("coms-theme");
                    theme = stored === "light" || stored === "dark" ? stored :
                        (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                }
                document.documentElement.setAttribute("data-theme", theme);
                document.documentElement.setAttribute("data-bs-theme", theme);
            } catch (e) {
                document.documentElement.setAttribute("data-theme", "light");
                document.documentElement.setAttribute("data-bs-theme", "light");
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
    <body>
        <script>window.isAuthenticated = @User.Identity.IsAuthenticated.ToString().ToLower();</script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="dashboard-wrapper d-flex">
            <partial name="_Sidebar" />
            <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

            <div class="main-content flex-fill d-flex flex-column min-vh-100">
                <partial name="_TopNavbar" />

                <main class="content-area flex-fill">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["AlertMessage"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            @TempData["AlertMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @RenderBody()
                </main>

                <footer class="footer border-top">
                    <div class="container-fluid py-2 px-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-c-circle me-1"></i>
                                COMS - Canal Obstruction Maintenance System | Philippines Local Government Prototype
                            </small>
                            <small class="text-muted">
                                @if (DateTime.UtcNow.Year == 2026)
                                {
                                    <text>2026</text>
                                }
                                else
                                {
                                    <text>2026 - @DateTime.UtcNow.Year</text>
                                }
                            </small>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        @* Anonymous pages (Login, Register, ...) are permanently light:
            no theme toggle here. The saved preference stays in localStorage
            and is restored automatically on the next authenticated page. *@
        <main class="content-area">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
