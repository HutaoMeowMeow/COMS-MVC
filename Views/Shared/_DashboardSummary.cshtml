@model DashboardViewModel
@{
    var colClass = Model.CurrentRole == "Admin" ? "col-6 col-md-4" : "col-6 col-md-4 col-xl";
}

<div class="row g-3 mb-4">
    <div class="@colClass">
        <div class="card stat-card h-100" style="--i:0">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon stat-tint-blue"><i class="bi bi-water"></i></span>
                <div>
                    <div class="stat-num">@Model.TotalCanals</div>
                    <div class="stat-label">Canals</div>
                    <div class="stat-sub">Monitored waterways</div>
                </div>
            </div>
        </div>
    </div>
    <div class="@colClass">
        <div class="card stat-card h-100" style="--i:1">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon stat-tint-green"><i class="bi bi-broadcast-pin"></i></span>
                <div>
                    <div class="stat-num">@Model.TotalSensors</div>
                    <div class="stat-label">Sensors</div>
                    <div class="stat-sub">
                        <span class="text-success fw-medium">@Model.OnlineSensors</span> online ·
                        <span class="text-danger fw-medium">@Model.OfflineSensors</span> offline
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="@colClass">
        <div class="card stat-card h-100" style="--i:2">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon stat-tint-red"><i class="bi bi-exclamation-triangle-fill"></i></span>
                <div>
                    <div class="stat-num">@Model.ActiveAlerts</div>
                    <div class="stat-label">Active alerts</div>
                    <div class="stat-sub">Needs attention</div>
                </div>
            </div>
        </div>
    </div>
    <div class="@colClass">
        <div class="card stat-card h-100" style="--i:3">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon stat-tint-amber"><i class="bi bi-journal-text"></i></span>
                <div>
                    <div class="stat-num">@Model.PendingReports</div>
                    <div class="stat-label">Pending reports</div>
                    <div class="stat-sub">Awaiting investigation</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CurrentRole == "Admin")
    {
        <div class="@colClass">
            <div class="card stat-card h-100" style="--i:4">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon stat-tint-slate"><i class="bi bi-bell-fill"></i></span>
                    <div>
                        <div class="stat-num">@Model.HighRiskCanals</div>
                        <div class="stat-label">High-risk canals</div>
                        <div class="stat-sub">Latest assessments</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="@colClass">
            <div class="card stat-card h-100" style="--i:5">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon stat-tint-blue"><i class="bi bi-people"></i></span>
                    <div>
                        <div class="stat-num">@Model.RegisteredUsers</div>
                        <div class="stat-label">Registered users</div>
                        <div class="stat-sub">All roles</div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="@colClass">
            <div class="card stat-card h-100" style="--i:4">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon stat-tint-slate"><i class="bi bi-bell-fill"></i></span>
                    <div>
                        <div class="stat-num">@Model.HighRiskCanals</div>
                        <div class="stat-label">High-risk canals</div>
                        <div class="stat-sub">Latest assessments</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>



