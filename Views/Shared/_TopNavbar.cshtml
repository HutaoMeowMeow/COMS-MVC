@inject COMS_MVC.Services.INotificationService NotificationService
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 py-2 top-navbar">
    <div class="container-fluid">
        <button id="sidebarToggle" class="navbar-toggler d-lg-none me-2" type="button"
                aria-controls="sidebarNav" aria-expanded="false" aria-label="Open navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <a class="navbar-brand fw-bold text-primary d-none d-lg-inline" href="#">
            @ViewData["PageTitle"]
        </a>
        <a class="navbar-brand fw-bold text-primary d-lg-none" href="#">
            COMS
        </a>

        <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary theme-toggle me-2" data-theme-toggle
                    aria-label="Switch color theme" aria-pressed="false" title="Toggle light / dark mode">
                <i class="bi bi-moon-fill" data-theme-toggle-icon aria-hidden="true"></i>
                <span class="d-none d-md-inline ms-1" data-theme-toggle-text>Dark</span>
            </button>
            <div class="dropdown">
                <button type="button" class="notification-bell btn btn-link nav-link text-dark me-3 position-relative"
                        id="notificationBell" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                    <i class="bi bi-bell fs-5"></i>
                    <span id="notification-count-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                          style="display:none;">
                        0
                    </span>
                </button>
                <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationBell">
                    <h6 class="dropdown-header d-flex justify-content-between align-items-center">
                        <span>Notifications</span>
                        <span id="notification-preview-unread" class="badge bg-danger" style="display:none;">0</span>
                    </h6>
                    <div id="notification-preview-list"></div>
                    <div class="dropdown-divider mb-0"></div>
                    <a class="dropdown-item text-center small py-2" asp-controller="Notifications" asp-action="Index">
                        View All Notifications
                    </a>
                </div>
            </div>

            <div class="dropdown">
                <a class="d-flex align-items-center text-decoration-none topbar-profile" href="#"
                   id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="avatar-tile me-2"
                         style="width: 36px; height: 36px;">
                        <span>
                            @{
                                var fullName = Context.User?.Identity?.Name ?? "U";
                                var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                var Initials = parts.Length >= 2
                                    ? parts[0][0].ToString().ToUpper() + parts[parts.Length - 1][0].ToString().ToUpper()
                                    : (parts.Length == 1 ? parts[0][0].ToString().ToUpper() : "U");
                            }
                            @Initials
                        </span>
                    </div>
                    <span class="d-none d-md-inline topbar-username">@User.Identity?.Name</span>
                    <i class="bi bi-chevron-down ms-1 small"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                    @if (User.IsInRole("Resident"))
                    {
                        <li><a class="dropdown-item" asp-controller="CustomerService" asp-action="Index"><i class="bi bi-headset me-2"></i>Customer Service</a></li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<script>
    (function () {
        function esc(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function typeIcon(type) {
            switch (type) {
                case 'Alert': return 'bi-exclamation-triangle-fill text-danger';
                case 'Report': case 'Report Update': return 'bi-journal-text text-warning';
                case 'Announcement': return 'bi-megaphone text-info';
                case 'Maintenance': return 'bi-gear-fill text-secondary';
                case 'Support': case 'Customer Service': return 'bi-chat-dots text-primary';
                case 'Account': return 'bi-person-fill text-primary';
                case 'System': return 'bi-gear-fill text-primary';
                case 'Important': return 'bi-exclamation-circle-fill text-danger';
                default: return 'bi-bell text-primary';
            }
        }

        // Native fetch: this inline script runs while the page is still parsing,
        // before footer libraries (jQuery) load, so `$` is not available here.
        function getJson(url) {
            return fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (response) {
                    if (!response.ok) throw new Error('request failed');
                    return response.json();
                });
        }

        function fetchUnreadCount() {
            getJson('/Notifications/UnreadCount').then(function (data) {
                var badge = document.getElementById('notification-count-badge');
                if (!badge) return;
                if (data.count > 0) {
                    badge.textContent = data.count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            }).catch(function () { });
        }

        // Scoped preview: the endpoint returns only the logged-in user's items.
        function refreshPreview() {
            var list = document.getElementById('notification-preview-list');
            if (!list) return;
            getJson('/Notifications/Recent').then(function (data) {
                var unreadBadge = document.getElementById('notification-preview-unread');
                if (unreadBadge) {
                    unreadBadge.textContent = data.unread;
                    unreadBadge.style.display = data.unread > 0 ? 'inline-block' : 'none';
                }
                if (!data.items || data.items.length === 0) {
                    list.innerHTML = '<div class="px-3 py-3 text-muted small">You are all caught up.</div>';
                    return;
                }
                list.innerHTML = data.items.map(function (n) {
                    return '<a class="dropdown-item notification-preview-item" href="/Notifications">' +
                        '<span class="d-flex gap-2 align-items-start">' +
                        '<i class="bi ' + typeIcon(n.type) + ' mt-1"></i>' +
                        '<span class="min-w-0">' +
                        '<span class="d-block text-truncate ' + (n.isRead ? '' : 'fw-bold') + '">' +
                        (n.isRead ? '' : '<span class="notif-unread-dot me-1"></span>') + esc(n.title) + '</span>' +
                        '<span class="d-block text-muted small text-truncate">' + esc(n.message) + '</span>' +
                        '<span class="d-block text-muted small">' + esc(n.createdAt) + '</span>' +
                        '</span></span></a>';
                }).join('');
            }).catch(function () { });
        }
        window.refreshNotificationPreview = refreshPreview;

        fetchUnreadCount();
        refreshPreview();
        setInterval(function () { fetchUnreadCount(); refreshPreview(); }, 30000);
    })();
</script>
